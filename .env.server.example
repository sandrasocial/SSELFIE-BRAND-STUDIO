# Server Environment Configuration
# Copy this file to .env.server and fill in your values

# Stack Auth
VITE_STACK_PROJECT_ID=your_project_id
VITE_STACK_PUBLISHABLE_KEY=your_publishable_key
STACK_SECRET_KEY=your_secret_key
STACK_WEBHOOK_SECRET=your_webhook_secret
STACK_ADMIN_KEY=your_admin_key

# Database
DATABASE_URL=your_database_url
PGUSER=your_pg_user
PGPASSWORD=your_pg_password
NEON_API_KEY=your_neon_api_key

# AI Services
REPLICATE_API_TOKEN=your_replicate_token
REPLICATE_USERNAME=your_replicate_username
ANTHROPIC_API_KEY=your_anthropic_key
GOOGLE_API_KEY=your_google_api_key

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_s3_bucket

# Admin Access
ADMIN_USER_ID=your_admin_user_id
SHANNON_USER_ID=your_shannon_user_id
ADMIN_TOKEN=your_admin_token

# Email Services
FLODESK_API_KEY=your_flodesk_key
RESEND_API_KEY=your_resend_key

# Social Media
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_id
META_ACCESS_TOKEN=your_meta_token
MANYCHAT_API_TOKEN=your_manychat_token
MAKE_API_TOKEN=your_make_token

# Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret_key
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_public_key

# Server Configuration
NODE_ENV=development
PORT=5000
NODEJS_HELPERS=0