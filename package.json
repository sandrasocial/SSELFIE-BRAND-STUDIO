{
  "name": "workspace",
  "type": "module",
  "version": "1.0.0",
  "main": "server/index.ts",
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "scripts": {
    "dev": "cd server && npx tsx index.ts",
    "dev:client": "npx vite --port 5173",
    "dev:server": "cd server && npx tsx start.ts",
    "start": "cd server && npx tsx index.ts",
    "build": "vite build --config vite.config.ts",
    "build:server": "npm run build:server:ts && npm run build:server:bundle",
    "build:server:ts": "tsc -p tsconfig.production.json --skipLibCheck --incremental",
    "build:server:bundle": "vite build --config=vite.config.ts --mode=production",
    "vercel-build": "npm run build && npm run build:server",
    "build:api": "npm run build:api:ts && npm run build:api:bundle",
    "build:api:ts": "tsc -p tsconfig.production.json --noEmit false --declaration --emitDeclarationOnly --skipLibCheck --outDir .vercel/output/functions/_types",
    "build:api:bundle": "esbuild api/**/*.ts --bundle --platform=node --format=esm --outdir=.vercel/output/functions --external:@google/genai --external:express --external:@aws-sdk/* --external:drizzle-orm --external:pg --external:ws --sourcemap --target=node20 --packages=external --tsconfig=tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "tsc --noEmit --skipLibCheck",
    "type-check:strict": "tsc --noEmit",
    "type-check:server": "tsc -p tsconfig.server.json --noEmit --skipLibCheck",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "lint:ci": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.37.0",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/lib-storage": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.884.0",
    "@google/genai": "^1.21.0",
    "@jest/types": "^30.0.5",
    "@neondatabase/serverless": "^1.0.1",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@replit/vite-plugin-cartographer": "^0.2.8",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.3",
    "@sendgrid/mail": "^8.1.6",
    "@slack/web-api": "^7.10.0",
    "@stackframe/react": "^2.8.36",
    "@stackframe/stack": "^2.8.36",
    "@stripe/react-stripe-js": "^3.10.0",
    "@stripe/stripe-js": "^7.9.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.18",
    "@tanstack/react-query": "^5.48.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/memoizee": "^0.4.12",
    "@types/node-cron": "^3.0.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sharp": "^0.31.1",
    "@types/stripe": "^8.0.416",
    "@vercel/node": "^5.3.22",
    "autoprefixer": "^10.4.21",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
