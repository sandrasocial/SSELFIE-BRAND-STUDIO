# Maya AI System Configuration
# Copy this file to .env.maya and fill in your values

# Stack Auth Integration
VITE_STACK_PROJECT_ID=your_project_id
VITE_STACK_PUBLISHABLE_KEY=your_publishable_key
STACK_SECRET_KEY=your_secret_key

# Database
DATABASE_URL=your_database_url

# AWS S3 for Asset Storage
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_maya_bucket

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stack Auth (Already configured)
NEXT_PUBLIC_STACK_PROJECT_ID=your-stack-project-id
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your-stack-client-key
STACK_SECRET_SERVER_KEY=your-stack-server-key

# Optional: AI Model Training (if using custom providers)
REPLICATE_API_TOKEN=your-replicate-token
OPENAI_API_KEY=your-openai-key

# Optional: Analytics and Monitoring
MAYA_ANALYTICS_ENABLED=true
MAYA_MONITORING_ENDPOINT=https://your-monitoring-service.com

# Development Settings
NODE_ENV=development
MAYA_DEBUG_MODE=true
MAYA_LOG_LEVEL=info