<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSELFIE | Complete Design System & Maya's Creative Intelligence</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        :root {
            /* Enhanced Color System */
            --black: #000000;
            --white: #ffffff;
            --cream: #faf9f7;
            --warm-white: #f8f7f4;
            --zinc-50: #fafafa;
            --zinc-100: #f4f4f5;
            --zinc-200: #e4e4e7;
            --zinc-300: #d4d4d8;
            --zinc-400: #a1a1aa;
            --zinc-500: #71717a;
            --zinc-600: #52525b;
            --zinc-700: #3f3f46;
            --zinc-800: #27272a;
            --zinc-900: #18181b;
            --zinc-950: #09090b;
            
            /* Earthy Accents */
            --warm-beige: #9a8d84;
            --greyge: #a39b96;
            --warm-gray: #8b8680;
            --sage: #9caa9c;
            --stone: #b5a991;
            
            /* Status Colors */
            --green-500: #22c55e;
            --red-500: #ef4444;
            --yellow-500: #eab308;
            
            /* Enhanced Spacing */
            --space-xs: 8px;
            --space-sm: 16px;
            --space-md: 24px;
            --space-lg: 32px;
            --space-xl: 48px;
            --space-2xl: 64px;
            --space-3xl: 96px;
            --space-4xl: 128px;
            --space-5xl: 160px;
            
            /* Typography Scale */
            --text-xs: 12px;
            --text-sm: 14px;
            --text-base: 16px;
            --text-lg: 18px;
            --text-xl: 20px;
            --text-2xl: 24px;
            --text-3xl: 30px;
            --text-4xl: 36px;
            --text-5xl: 48px;
            --text-6xl: 60px;
            --text-7xl: 72px;
            --text-8xl: 96px;
            --text-9xl: 128px;
            
            /* Shadows */
            --shadow-soft: 0 4px 20px rgba(0, 0, 0, 0.1);
            --shadow-medium: 0 8px 40px rgba(0, 0, 0, 0.12);
            --shadow-strong: 0 20px 60px rgba(0, 0, 0, 0.15);
            
            /* Border Radius */
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --radius-2xl: 32px;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            font-weight: 300;
            line-height: 1.7;
            color: var(--white);
            background: var(--black);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 var(--space-md);
        }
        
        .wide-container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 0 var(--space-md);
        }
        
        .section {
            padding: var(--space-5xl) 0;
            border-bottom: 1px solid var(--zinc-800);
            position: relative;
        }
        
        .section:last-child {
            border-bottom: none;
        }
        
        /* Enhanced Typography */
        .title-hero {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-6xl), 8vw, 120px);
            font-weight: 100;
            line-height: 0.8;
            letter-spacing: 0.5em;
            text-transform: uppercase;
            margin-bottom: var(--space-xl);
            background: linear-gradient(135deg, var(--white) 0%, var(--zinc-300) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .title-section {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-3xl), 5vw, var(--text-6xl));
            font-weight: 100;
            line-height: 0.9;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            margin-bottom: var(--space-2xl);
            position: relative;
        }
        
        .title-section::after {
            content: '';
            position: absolute;
            bottom: -var(--space-lg);
            left: 0;
            width: 60px;
            height: 2px;
            background: var(--warm-beige);
        }
        
        .title-subsection {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-lg), 2.5vw, var(--text-2xl));
            font-weight: 200;
            line-height: 1.1;
            letter-spacing: 0.15em;
            text-transform: uppercase;
            margin-bottom: var(--space-lg);
        }
        
        .eyebrow {
            font-size: var(--text-xs);
            font-weight: 400;
            letter-spacing: 0.4em;
            text-transform: uppercase;
            color: var(--greyge);
            margin-bottom: var(--space-lg);
            position: relative;
        }
        
        .eyebrow::after {
            content: '';
            position: absolute;
            top: 50%;
            right: -var(--space-xl);
            width: 40px;
            height: 1px;
            background: var(--greyge);
            opacity: 0.6;
        }
        
        .body-text {
            font-size: clamp(var(--text-sm), 1.5vw, var(--text-base));
            line-height: 1.8;
            font-weight: 300;
            color: var(--zinc-300);
            max-width: 65ch;
        }
        
        .body-large {
            font-size: clamp(var(--text-base), 2vw, var(--text-xl));
            line-height: 1.6;
            font-weight: 300;
            color: var(--zinc-200);
            max-width: 50ch;
        }
        
        /* Hero Section with Visual Impact */
        .hero-section {
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: radial-gradient(ellipse at center, rgba(255, 255, 255, 0.02) 0%, transparent 70%);
            position: relative;
            overflow: hidden;
            padding: var(--space-2xl) 0;
        }
        
        .hero-visual {
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 50%;
            height: 80vh;
            background: linear-gradient(135deg, var(--zinc-900) 0%, var(--zinc-800) 100%);
            border-radius: var(--radius-2xl);
            opacity: 0.1;
        }
        
        .hero-content {
            position: relative;
            z-index: 2;
        }
        
        /* Maya's Creative Lookbooks */
        .lookbook-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--space-lg);
            margin: var(--space-2xl) 0;
        }
        
        .lookbook-card {
            background: var(--zinc-900);
            border: 1px solid var(--zinc-800);
            border-radius: var(--radius-lg);
            padding: var(--space-xl);
            transition: all 500ms ease;
            position: relative;
            overflow: hidden;
        }
        
        .lookbook-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at top right, rgba(163, 144, 129, 0.1) 0%, transparent 50%);
            opacity: 0;
            transition: opacity 500ms ease;
        }
        
        .lookbook-card:hover::before {
            opacity: 1;
        }
        
        .lookbook-card:hover {
            border-color: rgba(163, 144, 129, 0.4);
            transform: translateY(-4px);
            box-shadow: var(--shadow-medium);
        }
        
        .lookbook-visual {
            width: 100%;
            height: 200px;
            background: linear-gradient(135deg, var(--zinc-700) 0%, var(--zinc-600) 100%);
            border-radius: var(--radius-md);
            margin-bottom: var(--space-lg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--zinc-400);
            font-size: var(--text-sm);
            position: relative;
        }
        
        .lookbook-tag {
            background: rgba(163, 144, 129, 0.1);
            border: 1px solid rgba(163, 144, 129, 0.3);
            color: var(--greyge);
            padding: var(--space-xs) var(--space-sm);
            border-radius: 20px;
            font-size: var(--text-xs);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: var(--space-md);
        }
        
        /* Maya's Profile Integration */
        .maya-profile {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            border: 2px solid var(--greyge);
            object-fit: cover;
        }
        
        .maya-header {
            display: flex;
            align-items: center;
            gap: var(--space-md);
            background: var(--zinc-800);
            padding: var(--space-lg);
            border-bottom: 1px solid var(--zinc-700);
        }
        
        .maya-info h4 {
            color: var(--white);
            margin-bottom: var(--space-xs);
            font-size: var(--text-base);
            font-weight: 300;
        }
        
        .maya-info p {
            color: var(--greyge);
            font-size: var(--text-sm);
        }
        
        /* Enhanced Chat Interface */
        .maya-chat {
            background: var(--zinc-900);
            border: 1px solid var(--zinc-800);
            border-radius: var(--radius-lg);
            overflow: hidden;
            max-width: 100%;
            margin: var(--space-xl) 0;
        }
        
        .maya-messages {
            padding: var(--space-lg);
            max-height: 400px;
            overflow-y: auto;
        }
        
        .message {
            margin-bottom: var(--space-lg);
            display: flex;
            flex-direction: column;
        }
        
        .message.user {
            align-items: flex-end;
        }
        
        .message.maya {
            align-items: flex-start;
        }
        
        .message-content {
            background: var(--zinc-800);
            padding: var(--space-md) var(--space-lg);
            border-radius: var(--radius-md);
            max-width: 85%;
            color: var(--zinc-200);
            font-size: var(--text-sm);
            line-height: 1.5;
            position: relative;
        }
        
        .message.maya .message-content {
            background: linear-gradient(135deg, rgba(163, 144, 129, 0.1) 0%, rgba(163, 144, 129, 0.05) 100%);
            border: 1px solid rgba(163, 144, 129, 0.2);
            color: var(--white);
        }
        
        .message-header {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            margin-bottom: var(--space-sm);
        }
        
        .message-header .maya-profile {
            width: 24px;
            height: 24px;
        }
        
        .message-header span {
            font-size: var(--text-xs);
            color: var(--greyge);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        
        /* Concept Cards Showcase */
        .concept-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--space-lg);
            margin: var(--space-2xl) 0;
        }
        
        .concept-card {
            background: linear-gradient(135deg, rgba(39, 39, 42, 0.2) 0%, rgba(24, 24, 27, 0.2) 100%);
            border: 1px solid var(--zinc-700);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            transition: all 500ms ease;
        }
        
        .concept-card:hover {
            border-color: var(--zinc-600);
            background: linear-gradient(135deg, rgba(39, 39, 42, 0.3) 0%, rgba(24, 24, 27, 0.3) 100%);
        }
        
        .concept-visual {
            width: 100%;
            height: 180px;
            background: linear-gradient(135deg, var(--zinc-700) 0%, var(--zinc-600) 100%);
            border-radius: var(--radius-md);
            margin-bottom: var(--space-md);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--zinc-500);
            font-size: var(--text-xs);
            letter-spacing: 0.1em;
            text-transform: uppercase;
        }
        
        .concept-type {
            background: rgba(163, 144, 129, 0.1);
            border: 1px solid rgba(163, 144, 129, 0.3);
            color: var(--greyge);
            padding: var(--space-xs) var(--space-sm);
            border-radius: 20px;
            font-size: var(--text-xs);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            display: inline-block;
            margin-bottom: var(--space-md);
        }
        
        .concept-title {
            font-family: 'Times New Roman', serif;
            font-size: var(--text-lg);
            font-weight: 200;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--white);
            margin-bottom: var(--space-sm);
        }
        
        .concept-description {
            color: var(--zinc-300);
            font-size: var(--text-sm);
            line-height: 1.6;
            margin-bottom: var(--space-lg);
        }
        
        /* Enhanced Color System */
        .color-system {
            margin: var(--space-3xl) 0;
        }
        
        .color-hero {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: var(--space-2xl);
            margin-bottom: var(--space-3xl);
            align-items: center;
        }
        
        .color-demo {
            background: var(--zinc-900);
            border-radius: var(--radius-xl);
            padding: var(--space-2xl);
            position: relative;
            overflow: hidden;
        }
        
        .color-demo::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--black) 0%, var(--zinc-600) 50%, var(--white) 100%);
        }
        
        .color-palette {
            display: flex;
            gap: var(--space-xs);
            margin: var(--space-lg) 0;
            flex-wrap: wrap;
        }
        
        .color-swatch-mini {
            width: 40px;
            height: 40px;
            border-radius: var(--radius-sm);
            border: 1px solid var(--zinc-700);
        }
        
        .color-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--space-xl);
            margin: var(--space-2xl) 0;
        }
        
        .color-group {
            background: var(--zinc-900);
            border: 1px solid var(--zinc-800);
            border-radius: var(--radius-lg);
            padding: var(--space-xl);
            box-shadow: var(--shadow-soft);
        }
        
        .color-sample {
            margin-bottom: var(--space-lg);
        }
        
        .color-swatch {
            height: 80px;
            border-radius: var(--radius-md);
            margin-bottom: var(--space-sm);
            border: 1px solid var(--zinc-700);
            position: relative;
            overflow: hidden;
        }
        
        .color-swatch::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(45deg, transparent 45%, rgba(255, 255, 255, 0.1) 50%, transparent 55%);
        }
        
        /* Premium Button Styles */
        .btn-primary {
            background: linear-gradient(135deg, var(--white) 0%, var(--zinc-100) 100%);
            color: var(--black);
            border: none;
            padding: var(--space-lg) var(--space-xl);
            border-radius: var(--radius-md);
            font-size: var(--text-sm);
            font-weight: 400;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 400ms ease;
            position: relative;
            overflow: hidden;
            min-height: 48px;
            box-shadow: var(--shadow-soft);
            width: 100%;
        }
        
        .btn-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, var(--black) 0%, var(--zinc-800) 100%);
            transform: translateY(100%);
            transition: transform 400ms ease;
        }
        
        .btn-primary:hover::before {
            transform: translateY(0);
        }
        
        .btn-primary:hover {
            color: var(--white);
            transform: translateY(-2px);
            box-shadow: var(--shadow-medium);
        }
        
        .btn-primary > span {
            position: relative;
            z-index: 1;
            transition: color 400ms ease;
        }
        
        .btn-secondary {
            background: transparent;
            color: var(--white);
            border: 1px solid var(--zinc-600);
            padding: var(--space-lg) var(--space-xl);
            border-radius: var(--radius-md);
            font-size: var(--text-sm);
            font-weight: 400;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 300ms ease;
            min-height: 48px;
            position: relative;
            overflow: hidden;
            width: 100%;
        }
        
        .btn-secondary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--zinc-800);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 300ms ease;
        }
        
        .btn-secondary:hover::before {
            transform: scaleX(1);
        }
        
        .btn-secondary:hover {
            border-color: var(--warm-beige);
            transform: translateY(-2px);
        }
        
        .btn-secondary > span {
            position: relative;
            z-index: 1;
        }
        
        /* Navigation Enhancement */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--zinc-800);
            z-index: 1000;
            padding: var(--space-md) 0;
            transition: all 300ms ease;
        }
        
        .nav.scrolled {
            background: rgba(0, 0, 0, 0.95);
            border-bottom-color: var(--zinc-700);
        }
        
        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .nav-logo {
            font-family: 'Times New Roman', serif;
            font-size: var(--text-xl);
            font-weight: 100;
            letter-spacing: 0.4em;
            text-transform: uppercase;
            color: var(--white);
            position: relative;
        }
        
        .nav-logo::after {
            content: '';
            position: absolute;
            bottom: -4px;
            left: 0;
            width: 30px;
            height: 1px;
            background: var(--warm-beige);
        }
        
        .nav-links {
            display: flex;
            gap: var(--space-lg);
            list-style: none;
        }
        
        .nav-links a {
            color: var(--zinc-400);
            text-decoration: none;
            font-size: var(--text-sm);
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            transition: all 300ms ease;
            position: relative;
        }
        
        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 1px;
            background: var(--warm-beige);
            transition: width 300ms ease;
        }
        
        .nav-links a:hover {
            color: var(--white);
        }
        
        .nav-links a:hover::after {
            width: 100%;
        }
        
        .main-content {
            margin-top: 0;
        }
        
        /* Mobile Optimizations */
        @media (max-width: 1024px) {
            .hero-visual {
                display: none;
            }
            
            .color-hero {
                grid-template-columns: 1fr;
            }
            
            .lookbook-grid {
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            }
        }
        
        @media (max-width: 768px) {
            :root {
                --space-5xl: 80px;
                --space-4xl: 64px;
                --space-3xl: 48px;
            }
            
            .container, .wide-container {
                padding: 0 var(--space-sm);
            }
            
            .section {
                padding: var(--space-3xl) 0;
            }
            
            .hero-section {
                min-height: 80vh;
                padding: var(--space-xl) 0;
            }
            
            .title-hero {
                font-size: clamp(var(--text-4xl), 12vw, var(--text-6xl));
                letter-spacing: 0.3em;
            }
            
            .title-section {
                font-size: clamp(var(--text-2xl), 6vw, var(--text-4xl));
                letter-spacing: 0.2em;
            }
            
            .eyebrow::after {
                display: none;
            }
            
            .color-grid, .lookbook-grid, .concept-cards {
                grid-template-columns: 1fr;
            }
            
            .nav-links {
                gap: var(--space-sm);
            }
            
            .nav-links a {
                font-size: var(--text-xs);
            }
            
            .message-content {
                max-width: 95%;
            }
            
            .btn-primary, .btn-secondary {
                padding: var(--space-md) var(--space-lg);
                font-size: var(--text-xs);
            }
            
            .maya-chat {
                margin: var(--space-lg) 0;
            }
        }
        
        @media (max-width: 480px) {
            .container, .wide-container {
                padding: 0 var(--space-xs);
            }
            
            .nav-container {
                padding: 0 var(--space-sm);
            }
            
            .nav-logo {
                font-size: var(--text-base);
            }
            
            .nav-links {
                gap: var(--space-xs);
            }
            
            .nav-links a {
                font-size: 10px;
            }
            
            .lookbook-card, .concept-card, .color-group {
                padding: var(--space-lg);
            }
        }
        
        /* Animation Classes */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 0.8s ease forwards;
        }
        
        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .stagger-1 { animation-delay: 0.1s; }
        .stagger-2 { animation-delay: 0.2s; }
        .stagger-3 { animation-delay: 0.3s; }
        .stagger-4 { animation-delay: 0.4s; }
        
        /* Floating Elements */
        .floating-element {
            animation: float 6s ease-in-out infinite;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-10px); }
        }
        
        /* Premium Loading States */
        .loading-shimmer {
            background: linear-gradient(90deg, var(--zinc-800) 25%, var(--zinc-700) 50%, var(--zinc-800) 75%);
            background-size: 200% 100%;
            animation: shimmer 2s infinite;
        }
        
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }
    </style>
</head>
<body>
    <!-- Enhanced Navigation -->
    <nav class="nav" id="navbar">
        <div class="container">
            <div class="nav-container">
                <div class="nav-logo">SSELFIE</div>
                <ul class="nav-links">
                    <li><a href="#brand">Brand</a></li>
                    <li><a href="#maya">Maya</a></li>
                    <li><a href="#lookbooks">Styles</a></li>
                    <li><a href="#colors">Colors</a></li>
                    <li><a href="#components">System</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="main-content">
        <!-- Hero Section -->
        <section class="hero-section">
            <div class="hero-visual"></div>
