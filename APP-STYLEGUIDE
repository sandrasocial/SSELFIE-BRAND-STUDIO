<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSELFIE | Complete Design System & Brand Guidelines</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        :root {
            /* Editorial Color System */
            --black: #000000;
            --white: #ffffff;
            --zinc-50: #fafafa;
            --zinc-100: #f4f4f5;
            --zinc-200: #e4e4e7;
            --zinc-300: #d4d4d8;
            --zinc-400: #a1a1aa;
            --zinc-500: #71717a;
            --zinc-600: #52525b;
            --zinc-700: #3f3f46;
            --zinc-800: #27272a;
            --zinc-900: #18181b;
            --zinc-950: #09090b;
            
            /* Status Colors */
            --green-500: #22c55e;
            --red-500: #ef4444;
            --yellow-500: #eab308;
            
            /* Editorial Spacing System */
            --space-xs: 8px;
            --space-sm: 16px;
            --space-md: 24px;
            --space-lg: 32px;
            --space-xl: 48px;
            --space-2xl: 64px;
            --space-3xl: 96px;
            --space-4xl: 128px;
            
            /* Typography Scale */
            --text-xs: 12px;
            --text-sm: 14px;
            --text-base: 16px;
            --text-lg: 18px;
            --text-xl: 20px;
            --text-2xl: 24px;
            --text-3xl: 30px;
            --text-4xl: 36px;
            --text-5xl: 48px;
            --text-6xl: 60px;
            --text-7xl: 72px;
            --text-8xl: 96px;
            --text-9xl: 128px;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
            font-weight: 300;
            line-height: 1.7;
            color: var(--white);
            background: var(--black);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 var(--space-md);
        }
        
        .section {
            padding: var(--space-4xl) 0;
            border-bottom: 1px solid var(--zinc-800);
        }
        
        .section:last-child {
            border-bottom: none;
        }
        
        /* Typography Classes */
        .title-hero {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-6xl), 8vw, var(--text-8xl));
            font-weight: 200;
            line-height: 0.85;
            letter-spacing: 0.4em;
            text-transform: uppercase;
            margin-bottom: var(--space-xl);
        }
        
        .title-section {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
            font-weight: 200;
            line-height: 0.9;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            margin-bottom: var(--space-2xl);
        }
        
        .title-subsection {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
            font-weight: 200;
            line-height: 1;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-bottom: var(--space-lg);
        }
        
        .eyebrow {
            font-size: var(--text-xs);
            font-weight: 300;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--zinc-500);
            margin-bottom: var(--space-lg);
        }
        
        .body-text {
            font-size: clamp(var(--text-base), 2vw, var(--text-lg));
            line-height: 1.7;
            font-weight: 300;
            color: var(--zinc-300);
            max-width: 65ch;
        }
        
        .body-large {
            font-size: clamp(var(--text-lg), 2.5vw, var(--text-xl));
            line-height: 1.6;
            font-weight: 300;
            color: var(--zinc-200);
            max-width: 60ch;
        }
        
        /* Color Showcase */
        .color-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: var(--space-xl);
            margin: var(--space-2xl) 0;
        }
        
        .color-group {
            background: var(--zinc-900);
            border: 1px solid var(--zinc-800);
            border-radius: 16px;
            padding: var(--space-xl);
        }
        
        .color-sample {
            margin-bottom: var(--space-lg);
        }
        
        .color-swatch {
            height: 80px;
            border-radius: 8px;
            margin-bottom: var(--space-sm);
            border: 1px solid var(--zinc-700);
        }
        
        .color-name {
            font-family: 'Times New Roman', serif;
            font-weight: 200;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-bottom: var(--space-xs);
            color: var(--white);
        }
        
        .color-code {
            font-family: 'Monaco', 'Menlo', monospace;
            font-size: var(--text-sm);
            color: var(--zinc-400);
            margin-bottom: var(--space-xs);
        }
        
        .color-usage {
            font-size: var(--text-sm);
            color: var(--zinc-500);
            line-height: 1.5;
        }
        
        /* Typography Showcase */
        .type-example {
            padding: var(--space-xl) 0;
            border-bottom: 1px solid var(--zinc-900);
        }
        
        .type-example:last-child {
            border-bottom: none;
        }
        
        .type-label {
            font-size: var(--text-xs);
            color: var(--zinc-500);
            letter-spacing: 0.3em;
            text-transform: uppercase;
            margin-bottom: var(--space-md);
        }
        
        /* Component Examples */
        .component-grid {
            display: grid;
            gap: var(--space-xl);
            margin: var(--space-2xl) 0;
        }
        
        .component-example {
            background: var(--zinc-900);
            border: 1px solid var(--zinc-800);
            border-radius: 16px;
            padding: var(--space-xl);
        }
        
        /* Button Examples */
        .btn-primary {
            background: var(--white);
            color: var(--black);
            border: none;
            padding: var(--space-lg) var(--space-xl);
            border-radius: 12px;
            font-size: var(--text-sm);
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 300ms ease;
            position: relative;
            overflow: hidden;
            min-height: 48px;
        }
        
        .btn-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: var(--black);
            transform: translateX(-100%);
            transition: transform 500ms ease;
        }
        
        .btn-primary:hover::before {
            transform: translateX(0);
        }
        
        .btn-primary:hover {
            color: var(--white);
            transform: scale(1.02);
        }
        
        .btn-primary > span {
            position: relative;
            z-index: 1;
            transition: color 500ms ease;
        }
        
        .btn-secondary {
            background: transparent;
            color: var(--white);
            border: 1px solid var(--zinc-700);
            padding: var(--space-lg) var(--space-xl);
            border-radius: 12px;
            font-size: var(--text-sm);
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 300ms ease;
            min-height: 48px;
        }
        
        .btn-secondary:hover {
            background: var(--zinc-800);
            border-color: var(--zinc-600);
            transform: scale(1.02);
        }
        
        /* Card Examples */
        .card-luxury {
            background: linear-gradient(135deg, rgba(39, 39, 42, 0.2) 0%, rgba(24, 24, 27, 0.2) 100%);
            border: 1px solid var(--zinc-700);
            border-radius: 16px;
            padding: var(--space-xl);
            transition: all 500ms ease;
        }
        
        .card-luxury:hover {
            border-color: var(--zinc-600);
            background: linear-gradient(135deg, rgba(39, 39, 42, 0.3) 0%, rgba(24, 24, 27, 0.3) 100%);
        }
        
        /* Input Examples */
        .input-luxury {
            background: rgba(39, 39, 42, 0.3);
            border: 1px solid var(--zinc-700);
            border-radius: 12px;
            padding: var(--space-lg);
            color: var(--white);
            font-size: var(--text-base);
            font-weight: 300;
            width: 100%;
            transition: all 300ms ease;
        }
        
        .input-luxury::placeholder {
            color: var(--zinc-500);
        }
        
        .input-luxury:focus {
            outline: none;
            border-color: var(--zinc-600);
            background: rgba(39, 39, 42, 0.5);
        }
        
        /* Voice Guide Styles */
        .voice-example {
            background: var(--zinc-900);
            border: 1px solid var(--zinc-800);
            border-radius: 12px;
            padding: var(--space-lg);
            margin: var(--space-md) 0;
        }
        
        .voice-do {
            border-left: 4px solid var(--green-500);
        }
        
        .voice-dont {
            border-left: 4px solid var(--red-500);
        }
        
        .voice-example-text {
            font-style: italic;
            color: var(--zinc-300);
            margin-bottom: var(--space-sm);
        }
        
        .voice-note {
            font-size: var(--text-sm);
            color: var(--zinc-500);
        }
        
        /* Layout Grid */
        .grid-demo {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: var(--space-md);
            margin: var(--space-xl) 0;
        }
        
        .grid-item {
            background: var(--zinc-800);
            border: 1px solid var(--zinc-700);
            border-radius: 8px;
            padding: var(--space-md);
            text-align: center;
            font-size: var(--text-sm);
            color: var(--zinc-400);
        }
        
        .col-3 { grid-column: span 3; }
        .col-4 { grid-column: span 4; }
        .col-6 { grid-column: span 6; }
        .col-8 { grid-column: span 8; }
        .col-12 { grid-column: span 12; }
        
        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .container {
                padding: 0 var(--space-sm);
            }
            
            .color-grid {
                grid-template-columns: 1fr;
            }
            
            .grid-demo {
                grid-template-columns: repeat(4, 1fr);
            }
            
            .col-3, .col-4, .col-6, .col-8 {
                grid-column: span 4;
            }
        }
        
        /* Navigation */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(0, 0, 0, 0.95);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--zinc-800);
            z-index: 1000;
            padding: var(--space-md) 0;
        }
        
        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .nav-logo {
            font-family: 'Times New Roman', serif;
            font-size: var(--text-xl);
            font-weight: 200;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--white);
        }
        
        .nav-links {
            display: flex;
            gap: var(--space-xl);
            list-style: none;
        }
        
        .nav-links a {
            color: var(--zinc-400);
            text-decoration: none;
            font-size: var(--text-sm);
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            transition: color 300ms ease;
        }
        
        .nav-links a:hover {
            color: var(--white);
        }
        
        /* Content offset for fixed nav */
        .main-content {
            margin-top: 80px;
        }
        
        /* Maya Chat Example */
        .maya-chat {
            background: var(--zinc-900);
            border: 1px solid var(--zinc-800);
            border-radius: 16px;
            overflow: hidden;
            max-width: 600px;
        }
        
        .maya-header {
            background: var(--zinc-800);
            padding: var(--space-lg);
            border-bottom: 1px solid var(--zinc-700);
        }
        
        .maya-messages {
            padding: var(--space-lg);
            max-height: 400px;
            overflow-y: auto;
        }
        
        .message {
            margin-bottom: var(--space-lg);
        }
        
        .message-user {
            text-align: right;
        }
        
        .message-content {
            display: inline-block;
            background: var(--zinc-800);
            padding: var(--space-md) var(--space-lg);
            border-radius: 12px;
            max-width: 80%;
            color: var(--zinc-200);
            font-size: var(--text-sm);
            line-height: 1.5;
        }
        
        .message-user .message-content {
            background: var(--zinc-700);
        }
        
        .maya-input {
            padding: var(--space-lg);
            border-top: 1px solid var(--zinc-800);
        }
        
        .concept-card {
            background: linear-gradient(135deg, rgba(39, 39, 42, 0.2) 0%, rgba(24, 24, 27, 0.2) 100%);
            border: 1px solid var(--zinc-700);
            border-radius: 16px;
            padding: var(--space-lg);
            margin: var(--space-md) 0;
        }
        
        .concept-category {
            background: rgba(39, 39, 42, 0.5);
            border: 1px solid var(--zinc-600);
            border-radius: 20px;
            padding: var(--space-xs) var(--space-md);
            display: inline-block;
            font-size: var(--text-xs);
            color: var(--zinc-300);
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: var(--space-md);
        }
        
        .concept-title {
            font-family: 'Times New Roman', serif;
            font-size: var(--text-lg);
            font-weight: 200;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--white);
            margin-bottom: var(--space-sm);
        }
        
        .concept-description {
            color: var(--zinc-300);
            font-size: var(--text-sm);
            line-height: 1.6;
            margin-bottom: var(--space-lg);
        }
    </style>
</head>
