<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SSELFIE | Modern Design System</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        :root {
            /* Stone Color System */
            --stone-50: #fafaf9;
            --stone-100: #f5f5f4;
            --stone-200: #e7e5e4;
            --stone-300: #d6d3d1;
            --stone-400: #a8a29e;
            --stone-500: #78716c;
            --stone-600: #57534e;
            --stone-700: #44403c;
            --stone-800: #292524;
            --stone-900: #1c1917;
            --stone-950: #0c0a09;
            
            /* Modern Spacing System */
            --space-1: 4px;
            --space-2: 8px;
            --space-3: 12px;
            --space-4: 16px;
            --space-5: 20px;
            --space-6: 24px;
            --space-8: 32px;
            --space-10: 40px;
            --space-12: 48px;
            --space-16: 64px;
            --space-20: 80px;
            --space-24: 96px;
            --space-32: 128px;
            
            /* Typography Scale */
            --text-xs: 12px;
            --text-sm: 14px;
            --text-base: 16px;
            --text-lg: 18px;
            --text-xl: 20px;
            --text-2xl: 24px;
            --text-3xl: 30px;
            --text-4xl: 36px;
            --text-5xl: 48px;
            --text-6xl: 60px;
            --text-7xl: 72px;
            --text-8xl: 96px;
            
            /* Modern Borders */
            --border-radius-sm: 6px;
            --border-radius: 8px;
            --border-radius-lg: 12px;
            --border-radius-xl: 16px;
            --border-radius-2xl: 24px;
            
            /* Shadows */
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            font-weight: 400;
            line-height: 1.6;
            color: var(--stone-950);
            background: var(--stone-50);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 var(--space-6);
        }
        
        .section {
            padding: var(--space-24) 0;
        }
        
        /* Editorial Typography */
        .title-hero {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-6xl), 8vw, var(--text-8xl));
            font-weight: 200;
            line-height: 0.85;
            letter-spacing: 0.4em;
            text-transform: uppercase;
            color: var(--stone-950);
            margin-bottom: var(--space-6);
        }
        
        .title-section {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
            font-weight: 200;
            line-height: 0.9;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--stone-900);
            margin-bottom: var(--space-16);
        }
        
        .title-subsection {
            font-family: 'Times New Roman', serif;
            font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
            font-weight: 200;
            line-height: 1;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--stone-800);
            margin-bottom: var(--space-4);
        }
        
        .eyebrow {
            font-size: var(--text-xs);
            font-weight: 300;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--stone-500);
            margin-bottom: var(--space-3);
        }
        
        .body-text {
            font-size: var(--text-base);
            line-height: 1.7;
            color: var(--stone-700);
            max-width: 65ch;
        }
        
        .body-large {
            font-size: var(--text-lg);
            line-height: 1.6;
            color: var(--stone-800);
            max-width: 60ch;
        }
        
        /* Modern Color Showcase */
        .color-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: var(--space-8);
            margin: var(--space-16) 0;
        }
        
        .color-group {
            background: var(--stone-100);
            border: 1px solid var(--stone-200);
            border-radius: var(--border-radius-xl);
            padding: var(--space-8);
            box-shadow: var(--shadow-sm);
        }
        
        .color-sample {
            margin-bottom: var(--space-6);
        }
        
        .color-swatch {
            height: 64px;
            border-radius: var(--border-radius);
            margin-bottom: var(--space-3);
            border: 1px solid var(--stone-200);
            box-shadow: var(--shadow-sm);
        }
        
        .color-name {
            font-weight: 600;
            margin-bottom: var(--space-1);
            color: var(--stone-900);
            font-size: var(--text-sm);
        }
        
        .color-code {
            font-family: 'SF Mono', Monaco, Consolas, monospace;
            font-size: var(--text-xs);
            color: var(--stone-600);
            background: var(--stone-200);
            padding: var(--space-1) var(--space-2);
            border-radius: var(--border-radius-sm);
            display: inline-block;
            margin-bottom: var(--space-2);
        }
        
        .color-usage {
            font-size: var(--text-xs);
            color: var(--stone-500);
            line-height: 1.4;
        }
        
        /* Modern Typography Showcase */
        .type-example {
            padding: var(--space-8) 0;
            border-bottom: 1px solid var(--stone-200);
        }
        
        .type-example:last-child {
            border-bottom: none;
        }
        
        .type-label {
            font-size: var(--text-xs);
            color: var(--stone-500);
            font-weight: 500;
            margin-bottom: var(--space-4);
            background: var(--stone-100);
            padding: var(--space-2) var(--space-3);
            border-radius: var(--border-radius-sm);
            display: inline-block;
        }
        
        /* Modern Components */
        .component-grid {
            display: grid;
            gap: var(--space-8);
            margin: var(--space-16) 0;
        }
        
        .component-example {
            background: var(--stone-100);
            border: 1px solid var(--stone-200);
            border-radius: var(--border-radius-xl);
            padding: var(--space-8);
            box-shadow: var(--shadow-sm);
        }
        
        /* Modern Buttons */
        .btn-primary {
            background: var(--stone-950);
            color: var(--stone-50);
            border: none;
            padding: var(--space-4) var(--space-6);
            border-radius: var(--border-radius);
            font-size: var(--text-sm);
            font-weight: 500;
            cursor: pointer;
            transition: all 200ms ease-out;
            position: relative;
            overflow: hidden;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-sm);
        }
        
        .btn-primary:hover {
            background: var(--stone-800);
            transform: translateY(-1px);
            box-shadow: var(--shadow-lg);
        }
        
        .btn-primary:active {
            transform: translateY(0);
            box-shadow: var(--shadow-sm);
        }
        
        .btn-secondary {
            background: transparent;
            color: var(--stone-700);
            border: 1px solid var(--stone-300);
            padding: var(--space-4) var(--space-6);
            border-radius: var(--border-radius);
            font-size: var(--text-sm);
            font-weight: 500;
            cursor: pointer;
            transition: all 200ms ease-out;
            min-height: 44px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        
        .btn-secondary:hover {
            background: var(--stone-100);
            border-color: var(--stone-400);
            color: var(--stone-800);
        }
        
        /* Visual Smart Home Cards */
        .card-modern {
            background: var(--stone-100);
            border: 1px solid var(--stone-200);
            border-radius: var(--border-radius-xl);
            padding: var(--space-8);
            transition: all 300ms ease-out;
            box-shadow: var(--shadow-sm);
        }
        
        .card-modern:hover {
            border-color: var(--stone-300);
            box-shadow: var(--shadow-lg);
            transform: translateY(-2px);
        }
        
        .card-visual {
            position: relative;
            background: var(--stone-200);
            border: 1px solid var(--stone-300);
            border-radius: var(--border-radius-xl);
            padding: 0;
            transition: all 400ms ease-out;
            box-shadow: var(--shadow);
            overflow: hidden;
            min-height: 280px;
        }
        
        .card-visual::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(12, 10, 9, 0.4) 0%, rgba(28, 25, 23, 0.6) 100%);
            z-index: 1;
            transition: all 400ms ease-out;
        }
        
        .card-visual:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: var(--shadow-xl);
        }
        
        .card-visual:hover::before {
            background: linear-gradient(135deg, rgba(12, 10, 9, 0.2) 0%, rgba(28, 25, 23, 0.4) 100%);
        }
        
        .card-visual-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            filter: brightness(0.8) contrast(1.1);
            transition: all 400ms ease-out;
        }
        
        .card-visual:hover .card-visual-bg {
            filter: brightness(0.9) contrast(1.2);
            transform: scale(1.05);
        }
        
        .card-visual-content {
            position: relative;
            z-index: 2;
            padding: var(--space-8);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            color: var(--stone-50);
        }
        
        .card-visual .concept-category {
            background: rgba(250, 250, 249, 0.2);
            border: 1px solid rgba(250, 250, 249, 0.3);
            color: var(--stone-100);
            backdrop-filter: blur(8px);
        }
        
        .card-visual .concept-title {
            color: var(--stone-50);
            text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
        }
        
        .card-visual .concept-description {
            color: var(--stone-200);
            text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
        }
        
        .card-visual .btn-primary {
            background: rgba(250, 250, 249, 0.9);
            color: var(--stone-950);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(250, 250, 249, 0.3);
        }
        
        .card-visual .btn-primary:hover {
            background: var(--stone-50);
            transform: translateY(-1px);
        }
        
        /* Smart Home Grid */
        .smart-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: var(--space-6);
            margin: var(--space-16) 0;
        }
        
        .hero-visual {
            position: relative;
            height: 400px;
            border-radius: var(--border-radius-2xl);
            overflow: hidden;
            box-shadow: var(--shadow-xl);
            margin: var(--space-16) 0;
        }
        
        .hero-visual-bg {
            position: absolute;
            inset: 0;
            background-size: cover;
            background-position: center;
            filter: brightness(0.7) contrast(1.1);
        }
        
        .hero-visual::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(12, 10, 9, 0.6) 0%, rgba(28, 25, 23, 0.4) 100%);
            z-index: 1;
        }
        
        .hero-visual-content {
            position: relative;
            z-index: 2;
            padding: var(--space-12);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            color: var(--stone-50);
        }
        
        .hero-visual .title-section {
            color: var(--stone-50);
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
            margin-bottom: var(--space-6);
        }
        
        .hero-visual .body-large {
            color: var(--stone-200);
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
        }
        
        /* Modern Inputs */
        .input-modern {
            background: var(--stone-100);
            border: 1px solid var(--stone-300);
            border-radius: var(--border-radius);
            padding: var(--space-4);
            color: var(--stone-900);
            font-size: var(--text-base);
            width: 100%;
            transition: all 200ms ease-out;
            box-shadow: var(--shadow-sm);
        }
        
        .input-modern::placeholder {
            color: var(--stone-500);
        }
        
        .input-modern:focus {
            outline: none;
            border-color: var(--stone-600);
            background: var(--stone-50);
            box-shadow: var(--shadow);
        }
        
        /* Modern Voice Examples */
        .voice-example {
            background: var(--stone-100);
            border-radius: var(--border-radius-lg);
            padding: var(--space-6);
            margin: var(--space-4) 0;
            box-shadow: var(--shadow-sm);
        }
        
        .voice-do {
            border-left: 4px solid #22c55e;
        }
        
        .voice-dont {
            border-left: 4px solid #ef4444;
        }
        
        .voice-example-text {
            font-style: italic;
            color: var(--stone-800);
            margin-bottom: var(--space-3);
            font-size: var(--text-base);
        }
        
        .voice-note {
            font-size: var(--text-sm);
            color: var(--stone-600);
            font-weight: 500;
        }
        
        /* Modern Layout Grid */
        .grid-demo {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: var(--space-4);
            margin: var(--space-12) 0;
        }
        
        .grid-item {
            background: var(--stone-200);
            border: 1px solid var(--stone-300);
            border-radius: var(--border-radius);
            padding: var(--space-4);
            text-align: center;
            font-size: var(--text-sm);
            color: var(--stone-700);
            font-weight: 500;
        }
        
        .col-3 { grid-column: span 3; }
        .col-4 { grid-column: span 4; }
        .col-6 { grid-column: span 6; }
        .col-8 { grid-column: span 8; }
        .col-12 { grid-column: span 12; }
        
        /* Editorial Navigation */
        .nav {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: rgba(250, 250, 249, 0.1);
            backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(215, 211, 209, 0.2);
            z-index: 1000;
            padding: var(--space-6) 0;
            transition: all 300ms ease-out;
            transform: translateY(0);
        }
        
        .nav:hover {
            background: rgba(250, 250, 249, 0.15);
            border-bottom-color: rgba(215, 211, 209, 0.3);
        }
        
        .nav-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            animation: navSlideIn 800ms ease-out;
        }
        
        @keyframes navSlideIn {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        .nav-logo {
            font-family: 'Times New Roman', serif;
            font-size: var(--text-2xl);
            font-weight: 200;
            letter-spacing: 0.3em;
            text-transform: uppercase;
            color: var(--stone-950);
            transition: all 300ms ease-out;
            animation: logoFadeIn 1000ms ease-out 200ms both;
        }
        
        @keyframes logoFadeIn {
            from {
                opacity: 0;
                letter-spacing: 0.5em;
            }
            to {
                opacity: 1;
                letter-spacing: 0.3em;
            }
        }
        
        .nav-logo:hover {
            letter-spacing: 0.35em;
        }
        
        .nav-links {
            display: flex;
            gap: var(--space-10);
            list-style: none;
        }
        
        .nav-links li {
            animation: linkSlideIn 600ms ease-out both;
        }
        
        .nav-links li:nth-child(1) { animation-delay: 400ms; }
        .nav-links li:nth-child(2) { animation-delay: 500ms; }
        .nav-links li:nth-child(3) { animation-delay: 600ms; }
        .nav-links li:nth-child(4) { animation-delay: 700ms; }
        .nav-links li:nth-child(5) { animation-delay: 800ms; }
        .nav-links li:nth-child(6) { animation-delay: 900ms; }
        
        @keyframes linkSlideIn {
            from {
                opacity: 0;
                transform: translateX(20px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        .nav-links a {
            color: var(--stone-700);
            text-decoration: none;
            font-size: var(--text-sm);
            font-weight: 300;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            transition: all 300ms ease-out;
            padding: var(--space-3) var(--space-4);
            border-radius: var(--border-radius-sm);
            position: relative;
        }
        
        .nav-links a::before {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 1px;
            background: var(--stone-800);
            transition: width 300ms ease-out;
        }
        
        .nav-links a:hover {
            color: var(--stone-950);
            background: rgba(250, 250, 249, 0.1);
            letter-spacing: 0.25em;
        }
        
        .nav-links a:hover::before {
            width: 80%;
        }
        
        /* Maya Chat with Avatar */
        .maya-chat {
            background: var(--stone-100);
            border: 1px solid var(--stone-200);
            border-radius: var(--border-radius-xl);
            overflow: hidden;
            max-width: 600px;
            box-shadow: var(--shadow);
        }
        
        .maya-header {
            background: var(--stone-200);
            padding: var(--space-6);
            border-bottom: 1px solid var(--stone-300);
            display: flex;
            align-items: center;
            gap: var(--space-4);
        }
        
        .maya-avatar {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background-size: cover;
            background-position: center;
            border: 2px solid var(--stone-300);
            box-shadow: var(--shadow-sm);
        }
        
        .maya-info {
            flex: 1;
        }
        
        .maya-status {
            display: flex;
            align-items: center;
            gap: var(--space-2);
            margin-top: var(--space-1);
        }
        
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 0 2px rgba(34, 197, 94, 0.2);
        }
        
        .maya-messages {
            padding: var(--space-6);
            max-height: 400px;
            overflow-y: auto;
        }
        
        .message {
            margin-bottom: var(--space-6);
        }
        
        .message-user {
            text-align: right;
        }
        
        .message-content {
            display: inline-block;
            background: var(--stone-200);
            padding: var(--space-4) var(--space-5);
            border-radius: var(--border-radius-lg);
            max-width: 80%;
            color: var(--stone-800);
            font-size: var(--text-sm);
            line-height: 1.5;
            box-shadow: var(--shadow-sm);
        }
        
        .message-user .message-content {
            background: var(--stone-300);
            color: var(--stone-900);
        }
        
        .maya-input {
            padding: var(--space-6);
            border-top: 1px solid var(--stone-300);
            background: var(--stone-50);
        }
        
        .concept-card {
            background: var(--stone-100);
            border: 1px solid var(--stone-200);
            border-radius: var(--border-radius-lg);
            padding: var(--space-6);
            margin: var(--space-4) 0;
            box-shadow: var(--shadow-sm);
        }
        
        .concept-category {
            background: var(--stone-200);
            border-radius: var(--border-radius-sm);
            padding: var(--space-1) var(--space-3);
            display: inline-block;
            font-size: var(--text-xs);
            color: var(--stone-700);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: var(--space-4);
        }
        
        .concept-title {
            font-size: var(--text-lg);
            font-weight: 600;
            color: var(--stone-900);
            margin-bottom: var(--space-2);
        }
        
        .concept-description {
            color: var(--stone-700);
            font-size: var(--text-sm);
            line-height: 1.6;
            margin-bottom: var(--space-6);
        }
        
        /* Mobile Responsiveness */
        @media (max-width: 768px) {
            .container {
                padding: 0 var(--space-4);
            }
            
            .color-grid {
                grid-template-columns: 1fr;
            }
            
            .grid-demo {
                grid-template-columns: repeat(4, 1fr);
            }
            
            .col-3, .col-4, .col-6, .col-8 {
                grid-column: span 4;
            }
            
            .nav {
                padding: var(--space-4) 0;
            }
            
            .nav-logo {
                font-size: var(--text-lg);
                letter-spacing: 0.2em;
            }
            
            .nav-links {
                gap: var(--space-6);
            }
            
            .nav-links a {
                font-size: var(--text-xs);
                letter-spacing: 0.15em;
                padding: var(--space-2) var(--space-3);
            }
            
            .main-content {
                margin-top: 80px;
            }
            
            .smart-grid {
                grid-template-columns: 1fr;
            }
        }
        
        /* Utility Classes */
        .mt-0 { margin-top: 0; }
        .mt-4 { margin-top: var(--space-4); }
        .mt-8 { margin-top: var(--space-8); }
        .mt-16 { margin-top: var(--space-16); }
        
        .mb-0 { margin-bottom: 0; }
        .mb-4 { margin-bottom: var(--space-4); }
        .mb-8 { margin-bottom: var(--space-8); }
        .mb-16 { margin-bottom: var(--space-16); }
        
        .text-center { text-align: center; }
        .text-left { text-align: left; }
        .text-right { text-align: right; }
        
        .flex { display: flex; }
        .flex-col { flex-direction: column; }
        .items-center { align-items: center; }
        .justify-center { justify-content: center; }
        .gap-4 { gap: var(--space-4); }
        .gap-8 { gap: var(--space-8); }
