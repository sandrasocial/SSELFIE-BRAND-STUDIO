    <script>
        // Enhanced navigation interactions
        const nav = document.querySelector('.nav');
        let lastScrollY = window.scrollY;
        
        window.addEventListener('scroll', () => {
            const currentScrollY = window.scrollY;
            
            if (currentScrollY > 50) {
                nav.style.background = 'rgba(250, 250, 249, 0.2)';
                nav.style.borderBottomColor = 'rgba(215, 211, 209, 0.4)';
            } else {
                nav.style.background = 'rgba(250, 250, 249, 0.1)';
                nav.style.borderBottomColor = 'rgba(215, 211, 209, 0.2)';
            }
            
            // Hide nav on scroll down, show on scroll up
            if (currentScrollY > lastScrollY && currentScrollY > 100) {
                nav.style.transform = 'translateY(-100%)';
            } else {
                nav.style.transform = 'translateY(0)';
            }
            
            lastScrollY = currentScrollY;
        });
        
        // Smooth scroll for navigation
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
        
        // Enhanced button interactions
        document.querySelectorAll('.btn-primary, .btn-secondary').forEach(button => {
            button.addEventListener('mouseenter', function() {
                this.style.transition = 'all 200ms ease-out';
            });
            
            button.addEventListener('mouseleave', function() {
                this.style.transition = 'all 200ms ease-out';
            });
        });
        
        // Card hover effects
        document.querySelectorAll('.card-modern, .concept-card').forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transition = 'all 300ms ease-out';
            });
            
            card.addEventListener('mouseleave', function() {
                this.style.transition = 'all 300ms ease-out';
            });
        });
    </script>
