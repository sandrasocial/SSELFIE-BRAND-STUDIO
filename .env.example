# Environment Configuration Template
# Copy this to .env and fill in actual values

# Database
DATABASE_URL=your_database_url_here

# Stack Auth
VITE_STACK_PROJECT_ID=your_stack_auth_project_id

STACK_AUTH_PROJECT_ID=your_stack_auth_project_id
STACK_SECRET_SERVER_KEY=your_stack_secret_server_key
VITE_STACK_PUBLISHABLE_CLIENT_KEY=your_vite_stack_publishable_client_key

# External Services
REPLICATE_API_TOKEN=your_replicate_token
REPLICATE_USERNAME=your_replicate_username
ANTHROPIC_API_KEY=your_anthropic_key

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name

# Admin Configuration
ADMIN_USER_ID=your_admin_user_id
SHANNON_USER_ID=your_shannon_user_id

# Email & Communication
FLODESK_API_KEY=your_flodesk_key
RESEND_API_KEY=your_resend_key

# CRM Integration
HIGHLEVEL_API_KEY=your_highlevel_api_key_here

# Social Media
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_id
META_ACCESS_TOKEN=your_meta_token
MANYCHAT_API_TOKEN=your_manychat_token
MAKE_API_TOKEN=your_make_token

# Server Configuration
NODE_ENV=development
PORT=3001
REPLIT_DEV_DOMAIN=your_replit_domain

# Payment Processing
STRIPE_SECRET_KEY=your_stripe_secret
TESTING_VITE_STRIPE_PUBLIC_KEY=your_stripe_public_test_key

# Stage Mode Configuration
ALLOWED_EMBED_HOSTS="mentimeter.com,*.mentimeter.com,canva.com,*.canva.com"
LIVE_SOCKET_ENABLED=1

# VEO 3 Video Generation Configuration
VEO3_ENABLED=0
GOOGLE_API_KEY=your_google_api_key_here
VEO3_MODEL=veo-3.0-generate-001
VEO_GOOGLE_MODEL=veo-2.0-generate-001

# Production Readiness - Monitoring
SENTRY_DSN=your_sentry_dsn_here
ANALYTICS_ID=your_analytics_id_here

# Production Readiness - Performance
CACHE_TTL=300
REDIS_URL=your_redis_url_here
SLOW_REQUEST_THRESHOLD=1000
MEMORY_THRESHOLD=80

# Production Readiness - Security
RATE_LIMIT_MAX=100
CORS_ORIGINS=https://yourdomain.com,https://staging.yourdomain.com
ALERT_WEBHOOK_URL=your_webhook_url_here
ALERT_CHANNELS=critical,warnings

# Production Readiness - Logging
LOG_LEVEL=info