{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "noEmit": false,
    "noEmitOnError": false,
    "module": "Node16",
    "moduleResolution": "node16",
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "strict": false
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "api/**/*.ts"
  ],
  "exclude": [
