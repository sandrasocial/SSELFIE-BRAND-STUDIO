{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/me.ts": {
      "maxDuration": 25
    },
    "api/gallery-images.ts": {
      "maxDuration": 30
    },
    "api/index.ts": {
      "maxDuration": 45
    },
    "api/maya/chat.ts": {
      "maxDuration": 45
    },
    "api/health-check.ts": {
      "maxDuration": 8
    },
    "api/health-detailed.ts": {
      "maxDuration": 10
    },
    "api/hair-trends.ts": {
      "maxDuration": 25
    },
    "api/hair-trends/status.ts": {
      "maxDuration": 15
    },
    "api/video/generate-from-image.ts": {
      "maxDuration": 45
    },
    "api/video/generate-story.ts": {
      "maxDuration": 30
    },
    "api/ping.ts": {
      "maxDuration": 5
    },
    "api/test.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/training-completion-monitor",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/generation-completion-monitor",
      "schedule": "* * * * *"
    }
  ]
}