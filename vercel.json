{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --force",
  "functions": {
    "server/api/maya/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "server/maya/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "server/api/gallery/*.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "server/api/**/*.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "server/webhooks/*.ts": {
      "maxDuration": 30,
      "memory": 512
    },
    "server/health.ts": {
      "maxDuration": 10,
      "memory": 256
    },
    "server/[...route].ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {"source": "/api/me", "destination": "/server/api/me.ts"},
    {"source": "/api/health", "destination": "/server/health.ts"},
    {"source": "/api/auth/user", "destination": "/server/api/auth/user.ts"},
    {"source": "/api/profile", "destination": "/server/api/profile.ts"},
    {"source": "/api/auth/auto-register", "destination": "/server/api/auth/auto-register.ts"},
    {"source": "/api/user/update-gender", "destination": "/server/api/user/update-gender.ts"},
    {"source": "/api/user-model", "destination": "/server/api/training/user-model.ts"},
    {"source": "/api/training/status", "destination": "/server/api/training/status.ts"},
    {"source": "/api/training-progress/(.*)", "destination": "/server/api/training/progress.ts"},
    {"source": "/api/maya/chat", "destination": "/server/api/maya/chat.ts"},
    {"source": "/api/maya/generate", "destination": "/server/api/maya/generate.ts"},
    {"source": "/api/maya/heart-image", "destination": "/server/api/maya/heart-image.ts"},
    {"source": "/api/maya-chats", "destination": "/server/api/maya/chats.ts"},
    {"source": "/api/maya/chat-history", "destination": "/server/api/maya/chat-history.ts"},
    {"source": "/api/maya/status", "destination": "/server/api/maya/status.ts"},
    {"source": "/api/maya/models", "destination": "/server/api/maya/models.ts"},
    {"source": "/api/maya/env-check", "destination": "/server/api/maya/env-check.ts"},
    {"source": "/api/maya/concepts", "destination": "/server/maya/concepts/index.ts"},
    {"source": "/api/maya/concepts/(.*)", "destination": "/server/maya/concepts/index.ts"},
    {"source": "/api/maya/images", "destination": "/server/maya/images/index.ts"},
    {"source": "/api/maya/images/(.*)", "destination": "/server/maya/images/index.ts"},
    {"source": "/api/maya/user-models", "destination": "/server/maya/models/index.ts"},
    {"source": "/api/maya/user-models/(.*)", "destination": "/server/maya/models/index.ts"},
    {"source": "/api/maya/profile", "destination": "/server/maya/profile/index.ts"},
    {"source": "/api/maya/payments", "destination": "/server/maya/payments/index.ts"},
    {"source": "/api/maya/payments/(.*)", "destination": "/server/maya/payments/index.ts"},
    {"source": "/api/gallery-images", "destination": "/server/api/gallery/images.ts"},
    {"source": "/api/gallery", "destination": "/server/api/gallery/images.ts"},
    {"source": "/api/images/favorites", "destination": "/server/api/gallery/favorites.ts"},
    {"source": "/api/images/(\\d+)/favorite", "destination": "/server/api/gallery/favorite-toggle.ts"},
    {"source": "/api/ai-images/(\\d+)", "destination": "/server/api/gallery/delete.ts"},
    {"source": "/api/webhooks/stack", "destination": "/server/webhooks/stack.ts"},
    {"source": "/api/webhooks/replicate", "destination": "/server/webhooks/replicate.ts"},
    {"source": "/api/cron/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/maya/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/admin/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/video/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/auth/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/handler/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/user-model", "destination": "/server/[...route].ts"},
    {"source": "/api/ai-images", "destination": "/server/[...route].ts"},
    {"source": "/api/onboarding", "destination": "/server/[...route].ts"},
    {"source": "/api/subscription", "destination": "/server/[...route].ts"},
    {"source": "/api/subscription/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/brandbook", "destination": "/server/[...route].ts"},
    {"source": "/api/generated-images", "destination": "/server/[...route].ts"},
    {"source": "/api/start-model-training", "destination": "/server/[...route].ts"},
    {"source": "/api/training-status", "destination": "/server/[...route].ts"},
    {"source": "/api/training/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/images/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/usage/(.*)", "destination": "/server/[...route].ts"},
    {"source": "/api/save-to-gallery", "destination": "/server/[...route].ts"},
    {
      "source": "/(app|maya|simple-training|training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center)",
      "destination": "/index.html"
    },
    {
      "source": "/(app|maya|simple-training|training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center)/",
      "destination": "/index.html"
    },
    {"source": "/app/(.*)", "destination": "/index.html"},
    {"source": "/handler/(.*)", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/api/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-store"}]
    }
  ],
  "redirects": [
    {"source": "/gallery-luxury-workspace.jpg", "destination": "/gallery-luxury-workspace.jpg", "permanent": true},
    {"source": "/hero-homepage.png", "destination": "/hero-homepage.png", "permanent": true},
    {"source": "/hero-about.png", "destination": "/hero-about.png", "permanent": true},
    {"source": "/hero-dashboard.png", "destination": "/hero-dashboard.png", "permanent": true},
    {"source": "/hero-luxury.png", "destination": "/hero-luxury.png", "permanent": true},
    {"source": "/favicon.png", "destination": "/favicon.png", "permanent": true},
    {"source": "/icon-192.png", "destination": "/icon-192.png", "permanent": true},
    {"source": "/icon-512.png", "destination": "/icon-512.png", "permanent": true},
    {"source": "/manifest.json", "destination": "/manifest.json", "permanent": true}
  ],
  "crons": [
    {
      "path": "/api/cron/check-training",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "TURBO_TELEMETRY_DISABLED": "1"
  },
  "deploymentEnabled": {
    "main": true,
    "develop": false
  },
  "github": {
    "autoAlias": false,
    "enabled": true,
    "autoJobCancelation": true
  }
}
