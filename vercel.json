{
  "framework": "vite",
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "client/dist",
  "functions": {
    "api/**": {
      "memory": 3008,
      "maxDuration": 60
    }
  },

  "rewrites": [
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/[...route]"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/api/auth/[...path]"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(app|maya|simple-training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center|sselfie-gallery|simple-checkout|payment-success|thank-you|auth-diagnostic|test-auth|stack-debug)",
      "destination": "/index.html"
    },
    {
      "source": "/(app|maya|simple-training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center|sselfie-gallery|simple-checkout|payment-success|thank-you|auth-diagnostic|test-auth|stack-debug)/",
      "destination": "/index.html"
    },
    {"source": "/app/(.*)", "destination": "/index.html"},
    {"source": "/handler/(.*)", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-training",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/migrate-replicate-urls",
      "schedule": "*/15 * * * *"
    }
  ],
  "github": {
    "autoAlias": false,
    "enabled": true,
    "autoJobCancelation": true
  }
}
