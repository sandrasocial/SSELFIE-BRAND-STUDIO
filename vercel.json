    {
      "src": "server/maya/models/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "memory": 512
      }
    },
    {
      "src": "server/maya/profile/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "memory": 512
      }
    },
    {
      "src": "server/api/gallery/images.ts",
      "use": "@vercel/node",
