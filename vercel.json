{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build",
        "outputDirectory": "client/dist"
      }
    },
    {
      "src": "api/[...route].ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 40,
        "memory": 1024,
        "includeFiles": [
          "dist-server/**",
          "server/**",
          "shared/**",
          "components/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/cron/(.*)",
      "dest": "api/[...route].ts",
      "methods": ["GET", "POST"],
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "api/[...route].ts",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/auth/(.*)",
      "dest": "api/auth/[...auth].ts"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/training-completion-monitor",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/generation-completion-monitor",
      "schedule": "* * * * *"
    }
  ],
  "build": {
    "env": {
      "VERCEL_FORCE_NO_BUILD_CACHE": "1"
    }
  }
}