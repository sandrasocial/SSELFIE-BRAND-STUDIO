{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install --force",
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": { 
        "cache-control": "public, max-age=31536000, immutable" 
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "headers": {
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
      },
      "continue": true
    },
    {
      "src": "/api/cron/(.*)",
      "dest": "api/[...route].ts",
      "methods": ["GET", "POST"],
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "api/[...route].ts",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "src": "/auth/(.*)",
      "dest": "api/auth/[...auth].ts"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/$1",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/training-completion-monitor",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/generation-completion-monitor", 
      "schedule": "* * * * *"
    }
  ],
  "build": {
    "env": {
      "VERCEL_FORCE_NO_BUILD_CACHE": "1"
    }
  },
  "functions": {
    "api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false
    }
  },
  "github": {
    "autoAlias": false,
    "enabled": true,
    "autoJobCancelation": true
  }
}