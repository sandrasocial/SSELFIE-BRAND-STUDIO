      "destination": "/index.html"
    },
    {
      "source": "/(app|maya|simple-training|training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center)/",
      "destination": "/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/handler/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/flatlay-luxury-planning.jpg",
      "destination": "/flatlay-luxury-planning.jpg"
    },
    {
      "source": "/gallery-luxury-workspace.jpg",
      "destination": "/gallery-luxury-workspace.jpg"
    },
    {
      "source": "/hero-homepage.png",
      "destination": "/hero-homepage.png"
    },
    {
      "source": "/hero-about.png",
      "destination": "/hero-about.png"
    },
    {
      "source": "/hero-dashboard.png",
      "destination": "/hero-dashboard.png"
    },
    {
      "source": "/hero-luxury.png",
      "destination": "/hero-luxury.png"
    },
    {
      "source": "/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/icon-192.png",
      "destination": "/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/icon-512.png"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!api).)*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/training-completion-monitor",
      "schedule": "*/2 * * * *"
    }
  ],
  "build": {
    "env": {
      "VERCEL_FORCE_NO_BUILD_CACHE": "1",
      "BUILD_TIMESTAMP": "2025-10-07-20-00-DEBUG"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false
    }
  },
  "github": {
    "autoAlias": false,
    "enabled": true,
    "autoJobCancelation": true
  }
}