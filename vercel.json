{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/me.ts": {
      "maxDuration": 20
    },
    "api/gallery-images.ts": {
      "maxDuration": 25
    },
    "api/index.ts": {
      "maxDuration": 40
    },
    "api/maya/chat.ts": {
      "maxDuration": 40
    },
    "api/maya/draft-storyboard.ts": {
      "maxDuration": 40
    },
    "api/auth/login.ts": {
      "maxDuration": 15
    },
    "api/auth/signup.ts": {
      "maxDuration": 15
    },
    "api/auth/callback.ts": {
      "maxDuration": 15
    },
    "api/health-check.ts": {
      "maxDuration": 5
    },
    "api/health-detailed.ts": {
      "maxDuration": 8
    },
    "api/hair-trends.ts": {
      "maxDuration": 20
    },
    "api/hair-trends/status.ts": {
      "maxDuration": 10
    },
    "api/video/generate-from-image.ts": {
      "maxDuration": 40
    },
    "api/video/generate-story.ts": {
      "maxDuration": 25
    },
    "api/ping.ts": {
      "maxDuration": 3
    },
    "api/hair-leads.ts": {
      "maxDuration": 10
    },
    "api/[...route].ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/training-completion-monitor",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/generation-completion-monitor",
      "schedule": "* * * * *"
    }
  ]
}