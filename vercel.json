{
  "version": 2,
  "builds": [
    {
      "src": "server/me.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 25,
        "memory": 512
      }
    },
    {
      "src": "server/health.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 10,
        "memory": 256
      }
    },
    {
      "src": "server/[...route].ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 1024,
        "includeFiles": [
          "server/**",
          "shared/**", 
          "drizzle/**",
          ".env*",
          "tsconfig*.json",
          "package.json",
          "server/storage.ts",
          "server/drizzle.ts",
          "server/stack-auth.ts",
          "shared/schema.ts",
          "shared/schema-maya.ts"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run vercel-build:safe",
        "outputDirectory": "client/dist",
        "installCommand": "npm install --force"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/me",
      "destination": "/server/me.ts"
    },
    {
      "source": "/api/health",
      "destination": "/server/health.ts"
    },
    {
      "source": "/api/cron/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/maya/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/admin/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/video/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/auth/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/handler/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/user-model",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/ai-images",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/onboarding",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/subscription",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/subscription/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/brandbook",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/generated-images",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/start-model-training",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/training-status",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/training/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/gallery-images",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/gallery",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/images/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/usage/(.*)",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/api/save-to-gallery",
      "destination": "/server/[...route].ts"
    },
    {
      "source": "/(app|simple-training|training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center)",
      "destination": "/index.html"
    },
    {
      "source": "/(app|simple-training|training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center)/",
      "destination": "/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/handler/(.*)",
      "destination": "/index.html"
    },
    {
      "src": "/flatlay-luxury-planning.jpg",
      "dest": "/public/flatlay-luxury-planning.jpg",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/gallery-luxury-workspace.jpg", 
      "dest": "/public/gallery-luxury-workspace.jpg",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/hero-homepage.png",
      "dest": "/public/hero-homepage.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/hero-about.png",
      "dest": "/public/hero-about.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/hero-dashboard.png",
      "dest": "/public/hero-dashboard.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/hero-luxury.png",
      "dest": "/public/hero-luxury.png",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "source": "/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/icon-192.png",
      "destination": "/icon-192.png"
    },
    {
      "source": "/icon-512.png",
      "destination": "/icon-512.png"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|webp|avif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!api).)*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/training-completion-monitor",
      "schedule": "*/2 * * * *"
    }
  ],
  "build": {
    "env": {
      "VERCEL_FORCE_NO_BUILD_CACHE": "1",
      "BUILD_TIMESTAMP": "2025-10-07-20-00-DEBUG"
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "develop": false
    }
  },
  "github": {
    "autoAlias": false,
    "enabled": true,
    "autoJobCancelation": true
  }
}