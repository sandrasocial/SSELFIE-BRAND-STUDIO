{
  "version": 2,
  "buildCommand": "pnpm build && pnpm build:api",
  "ignoreCommand": "false",
  "outputDirectory": "dist",
  "functions": {
    "api/maya-*.ts": {
      "memory": 3008,
      "maxDuration": 30
    },
    "api/**": {
      "memory": 1024,
      "maxDuration": 10
    }
  },

  "rewrites": [
    {
      "source": "/(app|maya|simple-training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center|sselfie-gallery|simple-checkout|payment-success|thank-you|auth-diagnostic)",
      "destination": "/index.html"
    },
    {
      "source": "/(app|maya|simple-training|auth-success|terms|privacy|sign-in|sign-up|magic-link|forgot-password|password-reset|business|ai-command-center|sselfie-gallery|simple-checkout|payment-success|thank-you|auth-diagnostic)/",
      "destination": "/index.html"
    },
    {"source": "/app/(.*)", "destination": "/index.html"},
    {"source": "/handler/(.*)", "destination": "/index.html"},
    {"source": "/api/maya/chat", "destination": "/api/maya-chat"},
    {"source": "/api/maya/chat-history", "destination": "/api/maya-chat-history"},
    {"source": "/api/maya/chats", "destination": "/api/maya-chats"},
    {"source": "/api/maya/status", "destination": "/api/maya-status"},
    {"source": "/api/maya/models", "destination": "/api/maya-models"},
    {"source": "/api/maya/heart-image", "destination": "/api/maya-heart-image"},
    {"source": "/api/maya/env-check", "destination": "/api/maya-env-check"}
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store"},
        {"key": "Access-Control-Allow-Origin", "value": "*"},
        {"key": "Access-Control-Allow-Methods", "value": "GET, POST, PUT, DELETE, OPTIONS"},
        {"key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-stack-access-token"},
        {"key": "Access-Control-Allow-Credentials", "value": "true"}
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-training",
      "schedule": "*/5 * * * *"
    }
  ],
  "env": {
    "TURBO_TELEMETRY_DISABLED": "1",
    "VITE_STACK_PROJECT_ID": "253d7343-a0d4-43a1-be5c-822f590d40be",
    "VITE_STACK_PUBLISHABLE_CLIENT_KEY": "pck_bqv6htnwq1f37nd2fn6qatxx2f8x0tnxvjj7xwgh1zmhg",
    "STACK_ENABLED": "true"
  },
  "github": {
    "autoAlias": false,
    "enabled": true,
    "autoJobCancelation": true
  }
}
