      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 1024
      }
    },
    {
      "src": "server/[...route].ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 60,
        "memory": 1024,
        "includeFiles": [
          "server/**",
          "shared/**", 
          "drizzle/**",
          ".env*",
          "tsconfig*.json",
          "package.json",
          "server/storage.ts",
          "server/drizzle.ts",
          "server/stack-auth.ts",
          "shared/schema.ts"
        ]
      }
    },
    {
      "src": "server/webhooks/stack.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "memory": 512
      }
    },
    {
      "src": "server/webhooks/replicate.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "memory": 512
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run vercel-build:safe",
        "outputDirectory": "client/dist",
        "installCommand": "npm install --force"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/me",
      "destination": "/server/api/me.ts"
    },
    {
      "source": "/api/health",
      "destination": "/server/health.ts"
    },
    {
      "source": "/api/me",
      "destination": "/server/api/me.ts"
    },
    {
      "source": "/api/auth/user",
